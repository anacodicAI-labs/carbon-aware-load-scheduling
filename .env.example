# Carbon-Aware Load Scheduling — API keys
# Copy this file to `.env` and fill in the real values (get them from the team's
# scc/.env.scc in the energy-load-forecasting repo). Nothing runs against the
# live APIs until these are set; the HVAC notebooks run offline on committed data.

# EIA Open Data API key — REQUIRED for the carbon signal (ISO-NE / CAISO fuel mix)
# Register free: https://www.eia.gov/opendata/register.php
EIA_API_KEY=

# Caltech ACN-Data API token — OPTIONAL, only for real EV charging jobs.
# Register free: https://ev.caltech.edu/  (also: pip install acnportal)
ACN_API_TOKEN=

# AI load (Alibaba GPU v2020) needs NO key — download the CSVs into data/ai/:
#   https://github.com/alibaba/clusterdata/tree/master/cluster-trace-gpu-v2020

# Optional: where the tested cuad package lives (defaults to the sibling
# energy-load-forecasting repo). Only set if that repo is somewhere else.
# CUAD_SRC=/abs/path/to/energy-load-forecasting/code/src
